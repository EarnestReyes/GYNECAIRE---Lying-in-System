# Existing API settings (replace placeholders; never commit live values)
PORT=5000
DATABASE_URL=postgresql://API_ROLE:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Imports fail closed without all of these. Generate a 32-byte key in your secret manager.
# Keep false until parser/integration checks, migration approval and security review pass.
IMPORTS_ENABLED=false
# After migration approval/application, keep cleanup on even while uploads are disabled.
IMPORT_RETENTION_ENABLED=false
# Keep the same key across API replicas; back it up securely. No sample secret is supplied.
IMPORT_ENCRYPTION_KEY=
# ClamAV must be on a trusted private network or localhost; never expose its TCP service.
IMPORT_CLAMD_HOST=
IMPORT_CLAMD_PORT=
