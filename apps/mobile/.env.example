EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
# Use your computer's LAN IP for physical phones, never localhost.
EXPO_PUBLIC_API_URL=http://localhost:5000
# Allow-list this exact callback plus its ?next=recover variant in Supabase Auth.
# Native builds: gynecairemobile://auth-callback
# Mobile web: http://localhost:8081/auth-callback
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8081/auth-callback
# Optional verified public clinic details. Leave blank until the clinic supplies them.
EXPO_PUBLIC_CLINIC_PHONE=
EXPO_PUBLIC_CLINIC_ADDRESS=
