{
  "expo": {
    "name": "GYNECAIRE",
    "slug": "gynecaire-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gynecaire-icon.png",
    "scheme": "gynecairemobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/gynecaire-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF3F8",
        "foregroundImage": "./assets/images/gynecaire-foreground.png",
        "monochromeImage": "./assets/images/gynecaire-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/gynecaire-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8FA",
          "image": "./assets/images/gynecaire-mark.png",
          "imageWidth": 88
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "backgroundColor": "#FFF8FA"
  }
}
