        </mxCell>
        <mxCell id="227" value="Client displays results and resumes its dashboard or workflow. Signing out ends the authenticated session.&#10;Public reads must be explicitly permitted; never use the guest path to expose private patient data." style="text;html=0;whiteSpace=wrap;overflow=visible;strokeColor=none;fillColor=none;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#263348;" vertex="1" parent="1">
