<mxCell id="page1_sql" value="Validate inputs where defined; parameterized SQL&#10;Transactions + audit for sensitive writes&#10;Direct pg connection; not user-JWT PostgREST&#10;A04, A08, A10, A16-A20" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1170" y="1280" width="520" height="115" as="geometry"/></mxCell>
<mxCell id="page1_db" value="Supabase PostgreSQL application data&#10;profiles, patients, staff_members, verifications,&#10;appointments, audit_logs, account_preferences&#10;RLS enabled; DB role/grants/apply state [U]&#10;D01-D11; A04" style="shape=cylinder;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#EEF2F6;strokeColor=#78899B;strokeWidth=1.7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1170" y="1470" width="520" height="150" as="geometry"/></mxCell>
<mxCell id="page1_response" value="Return JSON result or error&#10;Refresh the requesting client view&#10;No automatic notification service" style="shape=parallelogram;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1170" y="1710" width="520" height="95" as="geometry"/></mxCell>
<mxCell id="page1_localBlocker" value="[U] CHECKED LOCAL CONFIGURATION&#10;Mobile .env.local has Supabase URL/public key only.&#10;EXPO_PUBLIC_API_URL and AUTH_REDIRECT_URL are absent there.&#10;Account data and recovery are blocked unless supplied externally.&#10;M08, M13; local values redacted" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#EEF2F6;strokeColor=#78899B;strokeWidth=1.7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="90" y="1080" width="920" height="160" as="geometry"/></mxCell>
<mxCell id="page1_rlsNote" value="[U] RLS IS NOT THE SAME AS EXPRESS AUTHORIZATION&#10;Only an own-profile SELECT client policy is represented.&#10;API pg connections do not SET ROLE or forward request.jwt.claims.&#10;Effective DB role, grants, BYPASSRLS and applied migrations are unknown.&#10;No remote service/database was queried. A04; D07-D10" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#EEF2F6;strokeColor=#78899B;strokeWidth=1.7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="90" y="1325" width="920" height="160" as="geometry"/></mxCell>
<mxCell id="page1_publicNote" value="[E] PUBLIC DOES NOT MEAN A PUBLIC CLINIC DATA API&#10;Education / clinic links bypass Express. The API public endpoint is health only.&#10;Medical documents, inventory, community posting and scheduling services are absent.&#10;Detailed mobile flow: page 2. Verification: page 3. Staff modules: page 4." style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#EEF2F6;strokeColor=#78899B;strokeWidth=1.7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="90" y="1570" width="920" height="145" as="geometry"/></mxCell>
