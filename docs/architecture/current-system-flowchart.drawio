<mxCell id="page1_own" value="Account: use JWT subject&#10;/care also checks patient type&#10;and own linked patient record&#10;No caller patient ID&#10;A05-A08" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1120" y="1060" width="285" height="140" as="geometry"/></mxCell>
