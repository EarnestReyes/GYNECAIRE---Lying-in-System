<mxCell id="page4_members" value="Yes: staff directory read only&#10;Client name / active filters&#10;Invite button disabled&#10;W17" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF4DF;strokeColor=#B8781E;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="590" y="1320" width="410" height="110" as="geometry"/></mxCell>
<mxCell id="page4_reportSQL" value="GET /reports?from=...&amp;to=...&#10;Maximum 366 days; SQL counts, zero months filled&#10;No clinical/financial report engine&#10;A21; A25" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1160" y="1180" width="550" height="120" as="geometry"/></mxCell>
