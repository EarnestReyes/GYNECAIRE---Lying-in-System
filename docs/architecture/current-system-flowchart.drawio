<mxCell id="page4_dashboard" value="Staff dashboard&#10;Real overview + year-to-date trends&#10;20 schedule rows / 6 audit events&#10;Low stock is unavailable, not zero&#10;W20; A13, A21" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="90" y="485" width="390" height="130" as="geometry"/></mxCell>
<mxCell id="page4_settings" value="Settings: Auth password change&#10;Identity read-only; clinic / notifications UI&#10;Direct Auth call, not Express write&#10;W18" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF4DF;strokeColor=#B8781E;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="590" y="485" width="410" height="130" as="geometry"/></mxCell>
<mxCell id="page4_patients" value="Patient directory / demographics&#10;Search, linkage filters, 15-row pages&#10;Add/edit; profile + 30 visits&#10;No archive / clinical notes&#10;W05-W07" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="90" y="730" width="390" height="130" as="geometry"/></mxCell>
<mxCell id="page4_appointments" value="Appointments: list/create/update&#10;Create pending; staff enters Manila time&#10;Reschedule or set supported status&#10;No slots/conflicts/assignment&#10;W11, W12" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF4DF;strokeColor=#B8781E;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="590" y="730" width="410" height="130" as="geometry"/></mxCell>
<mxCell id="page4_patientSQL" value="GET /patients, GET /patients/:id&#10;POST /patients, PUT /patients/:id&#10;Validated parameterized writes + audit transaction&#10;Clinic record creation does NOT create Auth user&#10;A14-A17; A25" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1160" y="690" width="550" height="145" as="geometry"/></mxCell>
<mxCell id="page4_appointmentSQL" value="GET /appointments, POST /appointments&#10;PATCH /appointments/:id&#10;Completed/cancelled rows locked against changes&#10;Any supported transition allowed while nonfinal&#10;Audit action only, not before/after history&#10;A18-A20; A25" style="shape=rectangle;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#FFF8FB;strokeColor=#8D315F;strokeWidth=1.7;" vertex="1" parent="1"><mxGeometry x="1160" y="930" width="550" height="145" as="geometry"/></mxCell>
