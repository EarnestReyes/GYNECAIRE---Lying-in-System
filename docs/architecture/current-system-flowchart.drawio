<mxCell id="page4_db" value="PostgreSQL represented tables&#10;patients / appointments / staff_members&#10;profiles / verifications / audit_logs&#10;Schema applied and execution privileges [U]" style="shape=cylinder;rounded=0;arcSize=50;size=18;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;fontSize=16;fontColor=#402438;fillColor=#EEF2F6;strokeColor=#78899B;strokeWidth=1.7;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1160" y="1660" width="550" height="135" as="geometry"/></mxCell>
